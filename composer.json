{
    "autoload": {
        "psr-4": {
            "CongregationManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "description": "Tool to manage Congregation based on Symfony framework.",
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^6.0"
        }
    },
    "license": "proprietary",
    "minimum-stability": "stable",
    "name": "lruozzi9/congregation-manager",
    "prefer-stable": true,
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "require": {
        "php": "^8.1",
        "ext-ctype": "*",
        "composer/package-versions-deprecated": "^1.11",
        "doctrine/annotations": "^1.0",
        "doctrine/collections": "^1.6",
        "doctrine/dbal": "^3.3",
        "doctrine/doctrine-bundle": "^2.4",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.10",
        "doctrine/persistence": "^2.2",
        "knplabs/knp-components": "^3.5",
        "knplabs/knp-paginator-bundle": "^5.8",
        "phpdocumentor/reflection-docblock": "^5.3",
        "psr/log": "^2.0",
        "sensio/framework-extra-bundle": "^6.1",
        "symfony/console": "^6.0",
        "symfony/dependency-injection": "^6.0",
        "symfony/doctrine-bridge": "^6.0",
        "symfony/dotenv": "^6.0",
        "symfony/event-dispatcher": "^6.0",
        "symfony/expression-language": "^6.0",
        "symfony/flex": "^1.3.1",
        "symfony/form": "^6.0",
        "symfony/framework-bundle": "^6.0",
        "symfony/http-foundation": "^6.0",
        "symfony/http-kernel": "^6.0",
        "symfony/intl": "^6.0",
        "symfony/lock": "^6.0",
        "symfony/mailer": "^6.0",
        "symfony/mime": "^6.0",
        "symfony/monolog-bundle": "^3.1",
        "symfony/options-resolver": "^6.0",
        "symfony/password-hasher": "^6.0",
        "symfony/process": "^6.0",
        "symfony/property-access": "^6.0",
        "symfony/property-info": "^6.0",
        "symfony/proxy-manager-bridge": "^6.0",
        "symfony/routing": "^6.0",
        "symfony/runtime": "^6.0",
        "symfony/security-bundle": "^6.0",
        "symfony/security-core": "^6.0",
        "symfony/security-http": "^6.0",
        "symfony/serializer": "^6.0",
        "symfony/stopwatch": "^6.0",
        "symfony/string": "^6.0",
        "symfony/translation": "^6.0",
        "symfony/translation-contracts": "^2.5",
        "symfony/twig-bridge": "^6.0",
        "symfony/twig-bundle": "^6.0",
        "symfony/validator": "^6.0",
        "symfony/web-link": "^6.0",
        "symfony/webpack-encore-bundle": "^1.13",
        "symfony/yaml": "^6.0",
        "symfonycasts/reset-password-bundle": "^1.11",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/intl-extra": "^3.3",
        "twig/twig": "^2.12|^3.0",
        "webmozart/assert": "^1.10"
    },
    "require-dev": {
        "behat/behat": "^3.10",
        "behat/mink": "^1.10",
        "dama/doctrine-test-bundle": "^6.7",
        "deployer/dist": "v7.0.0-rc.4",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.6",
        "friends-of-behat/page-object-extension": "^0.3.2",
        "friends-of-behat/symfony-extension": "^2.3",
        "pds/skeleton": "^1.0",
        "phparkitect/phparkitect": "^0.2.15",
        "phpspec/prophecy": "^1.15",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpstan/phpstan": "^1.1",
        "phpstan/phpstan-webmozart-assert": "^1.0",
        "phpunit/phpunit": "^9.5",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^6.0",
        "symfony/css-selector": "^6.0",
        "symfony/debug-bundle": "^6.0",
        "symfony/maker-bundle": "^1.36",
        "symfony/phpunit-bridge": "^6.0",
        "symfony/web-profiler-bundle": "^6.0",
        "symplify/easy-coding-standard": "^9.4",
        "vimeo/psalm": "^4.12"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "pds": "vendor/bin/pds-skeleton validate",
        "ecs": "vendor/bin/ecs check src tests",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "psalm": "vendor/bin/psalm",
        "phparkitect": "vendor/bin/phparkitect check",
        "unit": "vendor/bin/phpunit",
        "behat": "vendor/bin/behat",
        "test": [
            "@pds",
            "@ecs",
            "@phparkitect",
            "@phpstan",
            "@psalm",
            "@unit",
            "@behat"
        ]
    },
    "type": "project"
}
