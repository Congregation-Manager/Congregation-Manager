{
    "authors": [
        {
            "name": "Lorenzo Ruozzi",
            "homepage": "https://congregation-manager.github.io"
        }
    ],
    "autoload": {
        "exclude-from-classmap": [
            "src/CongregationManager/*/*/tests/"
        ],
        "psr-4": {
            "CongregationManager\\Bundle\\Admin\\": "src/CongregationManager/Bundle/Admin/src/",
            "CongregationManager\\Bundle\\App\\": "src/CongregationManager/Bundle/App/src/",
            "CongregationManager\\Bundle\\Congregation\\": "src/CongregationManager/Bundle/Congregation/src/",
            "CongregationManager\\Bundle\\Core\\": "src/CongregationManager/Bundle/Core/src/",
            "CongregationManager\\Bundle\\Resource\\": "src/CongregationManager/Bundle/Resource/src/",
            "CongregationManager\\Bundle\\TerritoryManager\\": "src/CongregationManager/Bundle/TerritoryManager/src/",
            "CongregationManager\\Bundle\\User\\": "src/CongregationManager/Bundle/User/src/",
            "CongregationManager\\Component\\Congregation\\": "src/CongregationManager/Component/Congregation/src",
            "CongregationManager\\Component\\User\\": "src/CongregationManager/Component/User/src/",
            "CongregationManager\\Component\\Core\\": "src/CongregationManager/Component/Core/src/",
            "CongregationManager\\Component\\TerritoryManager\\": "src/CongregationManager/Component/TerritoryManager/src/",
            "CongregationManager\\Contract\\Resource\\": "src/CongregationManager/Contract/Resource/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Bundle\\Admin\\Tests\\": "src/CongregationManager/Bundle/Admin/tests/",
            "CongregationManager\\Bundle\\App\\Tests\\": "src/CongregationManager/Bundle/App/tests/",
            "CongregationManager\\Bundle\\Congregation\\Tests\\": "src/CongregationManager/Bundle/Congregation/tests/",
            "CongregationManager\\Bundle\\Core\\Tests\\": "src/CongregationManager/Bundle/Core/tests/",
            "CongregationManager\\Bundle\\Resource\\Tests\\": "src/CongregationManager/Bundle/Resource/tests/",
            "CongregationManager\\Bundle\\TerritoryManager\\Tests\\": "src/CongregationManager/Bundle/TerritoryManager/tests/",
            "CongregationManager\\Bundle\\User\\Tests\\": "src/CongregationManager/Bundle/User/tests/",
            "CongregationManager\\Component\\Congregation\\Tests\\": "src/CongregationManager/Component/Congregation/tests/",
            "CongregationManager\\Component\\User\\Tests\\": "src/CongregationManager/Component/User/tests/",
            "CongregationManager\\Component\\TerritoryManager\\Tests\\": "src/CongregationManager/Component/TerritoryManager/tests/",
            "CongregationManager\\Component\\Core\\Tests\\": "src/CongregationManager/Component/Core/tests/",
            "CongregationManager\\Contract\\Resource\\Tests\\": "src/CongregationManager/Contract/Resource/tests/",
            "CongregationManager\\Behat\\": "src/CongregationManager/Behat/src/",
            "CongregationManager\\Behat\\Tests\\": "src/CongregationManager/Behat/tests/",
            "CongregationManager\\Bundle\\FixturesBundle\\": "src/CongregationManager/Bundle/Fixtures/src/",
            "CongregationManager\\Bundle\\FixturesBundle\\Tests\\": "src/CongregationManager/Bundle/Fixtures/tests/"
        },
        "classmap": [
            "src/Kernel.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "description": "Tool to manage Congregation based on Symfony framework.",
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        },
        "symfony": {
            "allow-contrib": false,
            "require": "^7.1"
        }
    },
    "license": "proprietary",
    "name": "congregation-manager/congregation-manager",
    "repositories": [
        {
            "type": "path",
            "url": "*/*"
        }
    ],
    "replace": {
        "congregation-manager/admin-bundle": "self.version",
        "congregation-manager/app-bundle": "self.version",
        "congregation-manager/congregation": "self.version",
        "congregation-manager/congregation-bundle": "self.version",
        "congregation-manager/core": "self.version",
        "congregation-manager/core-bundle": "self.version",
        "congregation-manager/resource-bundle": "self.version",
        "congregation-manager/resource-contract": "self.version",
        "congregation-manager/territory-manager": "self.version",
        "congregation-manager/territory-manager-bundle": "self.version",
        "congregation-manager/user": "self.version",
        "congregation-manager/user-bundle": "self.version",
        "congregation-manager/fixtures-bundle": "self.version",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "composer/package-versions-deprecated": "^1.11.99.5",
        "doctrine/annotations": "^2.0.1",
        "doctrine/collections": "^2.1.4",
        "doctrine/dbal": "^3.7.2",
        "doctrine/doctrine-bundle": "^2.11.1",
        "doctrine/doctrine-migrations-bundle": "^3.3.0",
        "doctrine/orm": "^2.17.1",
        "doctrine/persistence": "^3.2.0",
        "knplabs/knp-components": "^5.1",
        "knplabs/knp-paginator-bundle": "^6.6",
        "phpdocumentor/reflection-docblock": "^5.3",
        "phpoffice/phpword": "^1.1.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.1.0",
        "symfony/console": "^7.1.1",
        "symfony/dependency-injection": "^7.1.1",
        "symfony/doctrine-bridge": "^7.1.0",
        "symfony/dotenv": "^7.1",
        "symfony/event-dispatcher": "^7.1.0",
        "symfony/expression-language": "^7.1.0",
        "symfony/flex": "^2.4.2",
        "symfony/form": "^7.1.1",
        "symfony/framework-bundle": "^7.1.1",
        "symfony/http-foundation": "^7.1.0",
        "symfony/http-kernel": "^7.1.1",
        "symfony/intl": "^7.1",
        "symfony/lock": "^7.1.0",
        "symfony/mailer": "^7.1",
        "symfony/mime": "^7.1.0",
        "symfony/monolog-bundle": "^3.10",
        "symfony/options-resolver": "^7.1",
        "symfony/password-hasher": "^7.1.0",
        "symfony/process": "^7.1.0",
        "symfony/property-access": "^7.1.0",
        "symfony/property-info": "^7.1.0",
        "symfony/routing": "^7.1.1",
        "symfony/runtime": "^7.1",
        "symfony/security-bundle": "^7.1.0",
        "symfony/security-core": "^7.1.0",
        "symfony/security-http": "^7.1.0",
        "symfony/serializer": "^7.1.1",
        "symfony/stopwatch": "^7.1.0",
        "symfony/string": "^7.1.0",
        "symfony/translation": "^7.1.0",
        "symfony/translation-contracts": "^3.4.0",
        "symfony/twig-bridge": "^7.1.0",
        "symfony/twig-bundle": "^7.1.0",
        "symfony/validator": "^7.1.0",
        "symfony/web-link": "^7.1",
        "symfony/webpack-encore-bundle": "^2.2",
        "symfony/yaml": "^7.1.0",
        "symfonycasts/reset-password-bundle": "^1.19.0",
        "twig/extra-bundle": "^2.12|^3.8",
        "twig/intl-extra": "^3.8.0",
        "twig/twig": "^2.12|^3.8.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "behat/behat": "^3.32",
        "behat/mink": "^1.13",
        "congregation-manager/fixtures-bundle": "dev-master",
        "dama/doctrine-test-bundle": "^8.2",
        "deployer/deployer": "^7.0",
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "friends-of-behat/mink-browserkit-driver": "^1.6.1",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7.4",
        "friends-of-behat/page-object-extension": "^0.3.2",
        "friends-of-behat/symfony-extension": "^2.4.2",
        "pds/skeleton": "^1.0",
        "phparkitect/phparkitect": "^1.3",
        "phpspec/prophecy": "^1.18",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^12.5",
        "psalm/plugin-symfony": "^5.3",
        "rector/rector": "^2.6",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^7.1",
        "symfony/css-selector": "^7.1.0",
        "symfony/debug-bundle": "^7.1.0",
        "symfony/maker-bundle": "^1.52",
        "symfony/phpunit-bridge": "^7.1",
        "symfony/web-profiler-bundle": "^7.1.0",
        "symplify/easy-coding-standard": "^12.0.13",
        "symplify/monorepo-builder": "11.2.19",
        "vimeo/psalm": "^6.16"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "pds": "vendor/bin/pds-skeleton validate",
        "ecs": "vendor/bin/ecs check src tests",
        "phpstan": "vendor/bin/phpstan analyse",
        "psalm": "vendor/bin/psalm",
        "rector": "vendor/bin/rector",
        "phparkitect": "vendor/bin/phparkitect check",
        "unit": "vendor/bin/phpunit",
        "behat": "vendor/bin/behat",
        "test": [
            "@pds",
            "@ecs",
            "@phparkitect",
            "@phpstan",
            "@psalm",
            "@rector",
            "@unit",
            "@behat"
        ]
    },
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true
}
