imports:
    - src/CongregationManager/Behat/config/suites.yaml

default:
    extensions:
        FriendsOfBehat\SymfonyExtension:
            bootstrap: tests/bootstrap.php
            kernel:
                class: 'CongregationManager\Bundle\Core\Kernel'

        Behat\MinkExtension:
            base_url: "https://localhost:8080/"
            sessions:
                symfony:
                    symfony: ~

        FriendsOfBehat\MinkDebugExtension:
            directory: "%paths.base%/etc/build"
            screenshot: true
            clean_start: true

    gherkin:
        filters:
            tags: '~@wip'
