{% if locales|length > 1 %}
    <div class="position-sticky pt-3">
        <ul class="nav flex-column">
            <li class="nav-item">
                <div class="dropdown">
                    <a class="nav-link" href="#" id="dropdown-locale" data-bs-toggle="dropdown" aria-expanded="false">
                        {{ active }}
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="dropdown-locale">
                        {% for locale in locales %}
                            {% if locale is not same as(active) %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('admin_switch_locale', {'locale': locale}) }}">
                                        {{ locale }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            </li>
        </ul>
    </div>
{% endif %}
