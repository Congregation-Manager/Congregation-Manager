{% extends 'app/base.html.twig' %}

{% block title %}{{ 'cm.territory.meta_title'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-8 col-lg-6">
                <h1>Territories</h1>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-12 com-md-3 col-lg-4">
                {{ form_start(form) }}
                <div class="accordion" id="accordion-filter">
                    <div class="accordion-item">
                        {% set accordionSelected = form.areas.vars['value'] is not empty %}
                        <h2 class="accordion-header" id="area-heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-area" aria-expanded="true" aria-controls="collapse-area">
                                Area{% if accordionSelected %} <span class="me-1 badge bg-primary">{{ form.areas.vars['value']|length }}</span>{%endif%}
                            </button>
                        </h2>
                        <div id="collapse-area" class="accordion-collapse collapse" aria-labelledby="area-heading" data-bs-parent="#accordion-filter">
                            <div class="accordion-body">
                                {{ form_row(form.areas) }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-grid gap-2 mt-2">
                    {{ form_widget(form.submit) }}
                    <a class="btn btn-secondary" href="{{ path('app_territories') }}">
                        Show all
                    </a>
                </div>
                {{ form_end(form) }}
            </div>
            <div class="col-12 com-md-9 col-lg-8">
                <div class="table-responsive-md">
                    <table class="table table-striped caption-top">
                        <caption>{{ pagination.totalItemCount }} territories</caption>
                        <thead>
                        <tr>
                            {# sorting of properties based on query components #}
                            <th>{{ knp_pagination_sortable(pagination, 'Name', 't.name') }}</th>
                            <th{% if pagination.isSorted('t.area') %} class="sorted"{% endif %}>
                                {{ knp_pagination_sortable(pagination, 'Area', 'a.name') }}
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        {# @var territory \CongregationManager\Domain\Territory\Model\Territory #}
                        {% for territory in pagination %}
                            <tr>
                                <td>
                                    {{ territory.name }}
                                </td>
                                <td>
                                    {{ territory.area.name }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="2" class="text-center">
                                    {{ 'cm.territory.no_results'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                {# display navigation #}
                <div class="navigation">
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>
        
        </div>
    </div>
{% endblock %}
