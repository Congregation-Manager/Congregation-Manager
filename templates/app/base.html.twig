{% extends 'base.html.twig' %}

{% block body %}
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_dashboard') }}">{{ 'app.app_nav.title'|trans }}</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#top-navbar" aria-controls="top-navbar" aria-expanded="false" aria-label="{{ 'app.app_nav.toggle'|trans }}">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="top-navbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    </ul>

                    <div class="dropdown float-end">
                        <a class="d-block text-decoration-none dropdown-toggle" href="#" id="dropdown-user" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://via.placeholder.com/35" alt="mdo" width="35" height="35" class="rounded-circle">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" aria-labelledby="dropdown-user">
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}">{{ 'app.app_nav.logout'|trans }}</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    {% block content %}{% endblock %}
{% endblock %}
