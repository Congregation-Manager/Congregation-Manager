{
    "name": "congregation-manager/resource-contract",
    "type": "library",
    "description": "Generic resource base for models on PHP applications.",
    "keywords": [
        "resource",
        "congregation-manager",
        "php"
    ],
    "homepage": "https://github.com/congregation-manager/congregation-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "Congregation Manager",
            "homepage": "https://github.com/Congregation-Manager"
        }
    ],
    "autoload": {
        "psr-4": {
            "CongregationManager\\Contract\\Resource\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Contract\\Resource\\Tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        }
    },
    "require": {
        "php": "^8.3"
    }
}
