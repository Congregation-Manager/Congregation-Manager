{
    "name": "congregation-manager/core",
    "type": "library",
    "description": "Congregation Manager suite for PHP applications.",
    "keywords": [
        "congregation-manager",
        "php"
    ],
    "homepage": "https://github.com/congregation-manager/congregation-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "Congregation Manager",
            "homepage": "https://github.com/Congregation-Manager"
        }
    ],
    "autoload": {
        "psr-4": {
            "CongregationManager\\Component\\Core\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Component\\Core\\Tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        }
    },
    "require": {
        "php": "^8.3",
        "congregation-manager/congregation": "self.version",
        "congregation-manager/resource-contract": "self.version",
        "congregation-manager/territory-manager": "self.version",
        "congregation-manager/user": "self.version",
        "doctrine/collections": "^2.1.4"
    }
}
