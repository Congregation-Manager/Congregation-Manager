{
    "name": "congregation-manager/territory-manager-bundle",
    "type": "library",
    "description": "Territory Manager for Symfony applications.",
    "keywords": [
        "territory",
        "congregation-manager",
        "territory-manager"
    ],
    "homepage": "https://github.com/congregation-manager/congregation-manager",
    "license": "proprietary",
    "authors": [
        {
            "name": "Lorenzo Ruozzi",
            "homepage": "https://lruozzi9.github.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "CongregationManager\\Bundle\\TerritoryManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Bundle\\TerritoryManager\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
