{% extends '@CongregationManagerAdmin/base.html.twig' %}

{% block title %}{{ 'congregation_manager_admin.ui.change_password'|trans_admin }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="row mb-3">
            <div class="col-12 col-md-8 col-lg-6">
                <h1>{{ 'congregation_manager_admin.ui.change_password'|trans_admin }}</h1>
            </div>
        </div>
        {{ form_start(changePasswordForm) }}
        <div class="row">
            <div class="col-12 col-md-8 col-lg-6">
                {{ form_row(changePasswordForm.oldPassword) }}
                {{ form_row(changePasswordForm.plainPassword) }}

                <button class="w-100 btn btn-lg btn-primary" type="submit">
                    {{ 'congregation_manager_admin.ui.save'|trans_admin }}
                </button>
            </div>
        </div>
        {{ form_end(changePasswordForm) }}
    </div>
{% endblock %}
