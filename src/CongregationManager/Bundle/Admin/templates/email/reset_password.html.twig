<h1>{{ 'congregation_manager_admin.email.reset_password.hello'|trans_admin({}, localeCode) }}</h1>

<p>{{ 'congregation_manager_admin.email.reset_password.intro'|trans_admin({}, localeCode) }}</p>

<p>{{ 'congregation_manager_admin.email.reset_password.action'|trans_admin({}, localeCode) }}</p>

{% set resetPasswordUrl = url('congregation_manager_admin_reset_password', {
    token: resetToken.token,
}) %}
<a href="{{ resetPasswordUrl }}">{{ resetPasswordUrl }}</a>

<p>
    {{ 'congregation_manager_admin.email.reset_password.expire'|trans_admin({
        '{expireIn}': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle', localeCode),
    }, localeCode) }}
</p>

<p>{{ 'congregation_manager_admin.email.reset_password.ignore_request'|trans_admin({}, localeCode) }}</p>

<p>{{ 'congregation_manager_admin.email.reset_password.greetings'|trans_admin({}, localeCode) }}</p>
