{% extends '@CongregationManagerAdmin/base.html.twig' %}

{# brother \CongregationManager\Component\Congregation\Domain\Brother #}

{% block title %}{{ 'congregation_manager_admin.ui.invite_brother_with_full_name'|trans_admin({'{full_name}': brother.fullName, 'sex': brother.sex}) }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="row mb-3">
            <div class="col-12 col-md-8 col-lg-6">
                <h1>{{ 'congregation_manager_admin.ui.invite_brother_with_full_name'|trans_admin({'{full_name}': brother.fullName, 'sex': brother.sex}) }}</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-md-8 col-lg-6">
                {{ form_start(inviteUserForm) }}
                {{ form_row(inviteUserForm.email, test_form_attribute('email')) }}
                {{ form_row(inviteUserForm.submit, test_form_attribute('submit')) }}
                {{ form_end(inviteUserForm) }}
            </div>
        </div>
    </div>
{% endblock %}
