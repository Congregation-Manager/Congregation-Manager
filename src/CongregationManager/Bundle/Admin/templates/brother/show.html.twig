{% extends '@CongregationManagerAdmin/base.html.twig' %}

{# brother \CongregationManager\Component\Congregation\Domain\Brother #}

{% block title %}{{ 'congregation_manager_admin.ui.brother_with_full_name'|trans_admin({'{full_name}': brother.fullName, 'sex': brother.sex}) }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="row mb-3">
            <div class="col-12 col-md-8 col-lg-6">
                <h1>{{ 'congregation_manager_admin.ui.brother_with_full_name'|trans_admin({'{full_name}': brother.fullName, 'sex': brother.sex}) }}</h1>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-12 col-md-8 col-lg-6">
                <ul>
                    <li>{{ 'congregation_manager_admin.ui.birth_date'|trans_admin }}: {{ brother.birthDate|date }}</li>
                    <li>{{ 'congregation_manager_admin.ui.baptism_date'|trans_admin }}: {{ brother.baptismDate|date }}</li>
                </ul>
            </div>
        </div>

        {% if brother.user %}
            <div class="card" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title">{{ 'congregation_manager_admin.ui.user'|trans_admin }}</h5>
                    <h6 class="card-subtitle mb-2 text-muted">{{ brother.user.email }}</h6>
                </div>
            </div>
        {% elseif brother.invitation %}
            <div class="card" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title" {{ test_html_attribute('user-invitation') }}>
                        {{ 'congregation_manager_admin.ui.invitation_sent'|trans_admin }}
                    </h5>
                </div>
            </div>
        {% else %}
            <div class="card" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title">{{ 'congregation_manager_admin.ui.invite_user_to_app'|trans_admin }}</h5>
                    <a href="{{ path('congregation_manager_admin_invite_app_user', {id: brother.id}) }}" class="btn btn-primary" {{ test_html_attribute('invite-user-button') }}>
                        {{ 'congregation_manager_admin.ui.invite'|trans_admin }}
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
