{% extends '@CongregationManagerAdmin/base.html.twig' %}

{% block title %}{{ 'congregation_manager_admin.ui.brothers_and_sisters'|trans_admin }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="row mb-3">
            <div class="col-12 col-md-8 col-lg-6">
                <h1>{{ 'congregation_manager_admin.ui.brothers_and_sisters'|trans_admin }}</h1>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-12 col-md-8 col-lg-6">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ 'congregation_manager_admin.ui.id'|trans_admin }}</th>
                        <th scope="col">{{ 'congregation_manager_admin.ui.first_name'|trans_admin }}</th>
                        <th scope="col">{{ 'congregation_manager_admin.ui.middle_name'|trans_admin }}</th>
                        <th scope="col">{{ 'congregation_manager_admin.ui.last_name'|trans_admin }}</th>
                        <th scope="col">{{ 'congregation_manager_admin.ui.email'|trans_admin }}</th>
                        <th scope="col">{{ 'congregation_manager_admin.ui.actions'|trans_admin }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for brother in brothers %}
                        <tr>
                            <th scope="row">{{ brother.id }}</th>
                            <td>{{ brother.firstName }}</td>
                            <td>{{ brother.middleName }}</td>
                            <td>{{ brother.lastName }}</td>
                            <td>{{ brother.user.email ?? '' }}</td>
                            <td>
                                <a href="{{ path('congregation_manager_admin_brother_show', {id: brother.id}) }}">
                                    {{ 'congregation_manager_admin.ui.details'|trans_admin }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
