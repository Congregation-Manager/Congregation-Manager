<!doctype html>
<html lang="{% block language %}{{ app.request.locale|slice(0, 2) }}{% endblock %}" {% if use_dark_theme() %}data-bs-theme="dark"{% endif %}>
<head>
    <meta charset="{% block charset %}UTF-8{% endblock %}">
    <meta name="description" content="{% block meta_description %}{{ 'cm.meta.description'|trans_admin }}{% endblock %}">
    <meta name="keywords" content="{% block meta_keywords %}{{ 'cm.meta.keywords'|trans_admin }}{% endblock %}">
    <meta name="author" content="{% block meta_author %}{{ 'cm.meta.author'|trans_admin }}{% endblock %}">
    <meta name="viewport" content="{% block meta_viewport %}width=device-width, initial-scale=1.0{% endblock %}">
    <meta name="theme-color" content="{% block meta_theme_color %}#ffffff{% endblock %}">
    <title>{% block title %}{{ 'cm.meta.title'|trans_admin }}{% endblock %}</title>
    <link rel="canonical" href="{% block canonical %}{{ app.request.uri }}{% endblock %}"/>

    <meta property="og:title" content="{% block meta_og_title %}{{ block('title') }}{% endblock %}" />
    <meta property="og:description" content="{% block meta_og_description %}{{ block('meta_description') }}{% endblock %}" />
    <meta property="og:type" content="{% block meta_og_type %}website{% endblock %}" />
    <meta property="og:url" content="{% block meta_og_url %}{{ block('canonical') }}{% endblock %}" />
    <meta property="og:image" content="{% block meta_og_image %}{{ asset('admin/build/images/logo.jpg', 'admin') }}{% endblock %}" />

    <meta name="robots" content="{% block meta_robots %}noindex,nofollow{% endblock %}">

    {% block favicon %}
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('admin/build/favicon/apple-touch-icon.png', 'admin') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('admin/build/favicon/favicon-32x32.png', 'admin') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('admin/build/favicon/favicon-16x16.png', 'admin') }}">
        <link rel="manifest" href="{{ asset('admin/build/favicon/site.webmanifest', 'admin') }}">
    {% endblock %}

    {% block stylesheets %}
        {{ encore_entry_link_tags('admin', null, 'admin') }}
    {% endblock %}
</head>
<body>
    {% block body %}
        {% block header %}
        <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
            <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3"
               href="{{ path('congregation_manager_admin_dashboard') }}">
                {{ 'cm.admin_nav.title'|trans }}
            </a>

            <button class="navbar-toggler position-absolute d-md-none collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#sidebar-menu"
                    aria-controls="sidebar-menu"
                    aria-expanded="false"
                    aria-label="{{ 'cm.admin_nav.toggle'|trans }}">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="w-100 row text-center">
                <div class="col">
                    <a class="d-block text-decoration-none text-white"
                       href="{{ path('congregation_manager_admin_profile_update') }}">
                        {{ 'cm.profile_update.title'|trans }}
                    </a>
                </div>
                <div class="col">
                    <a class="d-block text-decoration-none text-white"
                       href="{{ path('congregation_manager_admin_change_password') }}">
                        {{ 'cm.change_password.title'|trans }}
                    </a>
                </div>
            </div>
            <div class="navbar-nav">
                <div class="nav-item text-nowrap">
                    <a class="nav-link px-3"
                       href="{{ path('congregation_manager_admin_logout') }}"
                       {{ test_html_attribute('logout-button') }}>
                        {{ 'cm.admin_nav.logout'|trans }}
                    </a>
                </div>
            </div>
        </header>
        {% endblock %}

        <div class="container-fluid">
            <div class="row">
                <nav id="sidebar-menu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                    <div class="position-sticky pt-3">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('congregation_manager_admin_dashboard') }}">
                                    <i class="bi bi-speedometer2"></i>
                                    {{ 'cm.label.dashboard'|trans }}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('congregation_manager_admin_congregation_index') }}">
                                    <i class="bi bi-house-door"></i>
                                    {{ 'cm.congregation.title'|trans }}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('congregation_manager_admin_brother_index') }}">
                                    <i class="bi bi-people"></i>
                                    {{ 'cm.brother.title'|trans }}
                                </a>
                            </li>
                        </ul>

                        <div class="mt-5 d-flex justify-content-center">
                            {{ render(controller('congregation_manager_admin.controller.locale::renderAction')) }}
                        </div>
                    </div>
                </nav>

                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3">
                        {% block content %}
                        {% endblock %}
                    </div>
                </main>
            </div>
        </div>
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('admin', null, 'admin') }}
    {% endblock %}
</body>
</html>
