{% extends '@CongregationManagerAdmin/base.html.twig' %}

{% block title %}{{ 'congregation_manager_admin.ui.congregations'|trans_admin }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="row mb-3">
            <div class="col-12 col-md-8 col-lg-6">
                <h1>{{ 'congregation_manager_admin.ui.congregations'|trans_admin }}</h1>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-12 col-md-8 col-lg-6">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ 'congregation_manager_admin.ui.id'|trans_admin }}</th>
                        <th scope="col">{{ 'congregation_manager_admin.ui.name'|trans_admin }}</th>
                        <th scope="col">{{ 'congregation_manager_admin.ui.actions'|trans_admin }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for congregation in congregations %}
                        <tr>
                            <th scope="row">{{ congregation.id }}</th>
                            <td>{{ congregation.name }}</td>
                            <td>
                                <a href="{{ path('congregation_manager_admin_congregation_show', {id: congregation.id}) }}">
                                    {{ 'congregation_manager_admin.ui.details'|trans_admin }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
