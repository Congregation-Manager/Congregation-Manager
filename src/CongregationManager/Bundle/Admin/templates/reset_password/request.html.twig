{% extends '@CongregationManagerAdmin/public.html.twig' %}

{% block title %}{{ 'congregation_manager_admin.ui.forgot_password'|trans_admin }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-12 col-md-8 col-lg-6 m-auto text-center mt-5">
            {{ block('logo') }}
            <h1 class="h3 mb-3 fw-normal">
                {{ 'congregation_manager_admin.ui.forgot_password'|trans_admin }}
            </h1>

            {% for flashError in app.flashes('reset_password_error') %}
                <div class="alert alert-danger" role="alert">
                    {{ flashError }}
                </div>
            {% endfor %}

            {{ form_start(requestForm) }}
            {{ form_row(requestForm.email) }}

            <div class="mt-2 mb-2">
                <small>
                    {{ 'congregation_manager_admin.ui.insert_your_email_to_recover_password'|trans_admin }}
                </small>
            </div>

            <button class="w-100 btn btn-lg btn-primary" type="submit">
                {{ 'congregation_manager_admin.ui.recover_password'|trans_admin }}
            </button>
            {{ form_end(requestForm) }}
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-8 col-lg-6 m-auto text-center mt-5">
            <a href="{{ path('congregation_manager_admin_login') }}">
                {{ 'congregation_manager_admin.ui.click_here_if_you_already_have_credentials'|trans_admin }}
            </a>
        </div>
    </div>
{% endblock %}
