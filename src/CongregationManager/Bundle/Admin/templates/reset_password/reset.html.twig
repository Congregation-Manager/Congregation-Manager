{% extends '@CongregationManagerAdmin/public.html.twig' %}

{% block title %}{{ 'congregation_manager_admin.ui.reset_password'|trans_admin }}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-12 col-md-8 col-lg-6 m-auto text-center mt-5">
            {{ block('logo') }}
            <h1 class="h3 mb-3 fw-normal">
                {{ 'congregation_manager_admin.ui.reset_password'|trans_admin }}
            </h1>

            {{ form_start(resetForm) }}
            {{ form_row(resetForm.plainPassword) }}
            <button class="w-100 btn btn-lg btn-primary" type="submit">
                {{ 'congregation_manager_admin.ui.save'|trans_admin }}
            </button>
            {{ form_end(resetForm) }}
        </div>
    </div>
{% endblock %}
