{
    "name": "congregation-manager/fixtures-bundle",
    "type": "symfony-bundle",
    "description": "Fixtures Symfony bundle.",
    "keywords": [
        "fixtures",
        "congregation-manager",
        "symfony"
    ],
    "homepage": "https://github.com/congregation-manager/congregation-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "Congregation Manager",
            "homepage": "https://github.com/Congregation-Manager"
        }
    ],
    "autoload": {
        "psr-4": {
            "CongregationManager\\Bundle\\FixturesBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Bundle\\FixturesBundle\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        }
    },
    "require": {
        "php": "^8.3",
        "congregation-manager/congregation": "self.version",
        "congregation-manager/core": "self.version",
        "congregation-manager/core-bundle": "self.version",
        "congregation-manager/user": "self.version",
        "doctrine/data-fixtures": "^2.0",
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "doctrine/persistence": "^3.2.0",
        "symfony/config": "^7.1.0",
        "symfony/dependency-injection": "^7.1.1",
        "symfony/http-kernel": "^7.1.1",
        "webmozart/assert": "^1.11"
    }
}
