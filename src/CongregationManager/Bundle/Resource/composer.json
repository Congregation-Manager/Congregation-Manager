{
    "name": "congregation-manager/resource-bundle",
    "type": "symfony-bundle",
    "description": "Resource contract Symfony bundle.",
    "keywords": [
        "congregation-manager",
        "symfony",
        "resource"
    ],
    "homepage": "https://github.com/congregation-manager/congregation-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "Congregation Manager",
            "homepage": "https://github.com/Congregation-Manager"
        }
    ],
    "autoload": {
        "psr-4": {
            "CongregationManager\\Bundle\\Resource\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Bundle\\Resource\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        }
    },
    "require": {
        "php": "^8.3",
        "congregation-manager/resource-contract": "self.version",
        "doctrine/dbal": "^3.7.2",
        "doctrine/doctrine-bundle": "^2.11.1",
        "symfony/dependency-injection": "^7.1.1",
        "symfony/http-foundation": "^7.1.0",
        "symfony/http-kernel": "^7.1.1",
        "symfony/uid": "^7.1"
    }
}
