<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="CongregationManager\Bundle\Core\Entity\Congregation" table="congregation">
        <one-to-many field="provinces" target-entity="CongregationManager\Bundle\Core\Entity\ProvinceInterface"
                     mapped-by="congregation"/>

        <one-to-many field="municipalities"
                     target-entity="CongregationManager\Bundle\Core\Entity\MunicipalityInterface"
                     mapped-by="congregation"/>

        <one-to-many field="areas" target-entity="CongregationManager\Bundle\Core\Entity\AreaInterface"
                     mapped-by="congregation"/>

        <one-to-many field="territories" target-entity="CongregationManager\Bundle\Core\Entity\TerritoryInterface"
                     mapped-by="congregation"/>
    </entity>
</doctrine-mapping>
