<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="CongregationManager\Component\Core\Domain\Territory" table="territory"
            repository-class="CongregationManager\Bundle\Core\Repository\TerritoryRepository">


        <field name="number" type="integer" nullable="false"/>

        <field name="description" type="text" nullable="true"/>

        <many-to-one field="congregation" target-entity="CongregationManager\Component\Core\Domain\CongregationInterface"
                     inversed-by="territories">
            <join-column name="congregation_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="area" target-entity="CongregationManager\Component\Core\Domain\AreaInterface"
                     inversed-by="territories">
            <join-column name="area_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <one-to-many field="territoryAssignments"
                     target-entity="CongregationManager\Component\Core\Domain\TerritoryAssignmentInterface"
                     mapped-by="territory"/>

        <unique-constraints>
            <unique-constraint columns="number,congregation_id"/>
        </unique-constraints>
    </entity>

</doctrine-mapping>
