<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="CongregationManager\Bundle\Core\Entity\Municipality" table="municipality"
            repository-class="CongregationManager\Bundle\TerritoryManager\Repository\MunicipalityRepository">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="name" type="string" length="255"/>

        <field name="description" type="string" length="255" nullable="true"/>

        <many-to-one field="congregation" target-entity="CongregationManager\Component\Core\Domain\CongregationInterface"
                     inversed-by="municipalities">
            <join-column name="congregation_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="province" target-entity="CongregationManager\Component\Core\Domain\ProvinceInterface"
                     inversed-by="municipalities">
            <join-column name="province_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <one-to-many field="areas" target-entity="CongregationManager\Component\Core\Domain\AreaInterface" mapped-by="municipality" />
    </entity>
</doctrine-mapping>
