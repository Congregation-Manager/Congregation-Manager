{
    "name": "lruozzi9/core-bundle",
    "type": "library",
    "description": "Congregation Manager core Symfony bundle. It integrates all other bundles into a full stack Symfony solution.",
    "keywords": [
        "congregation-manager",
        "symfony"
    ],
    "homepage": "https://github.com/lruozzi9/congregation-manager",
    "license": "proprietary",
    "authors": [
        {
            "name": "Lorenzo Ruozzi",
            "homepage": "https://lruozzi9.github.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "CongregationManager\\Bundle\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Bundle\\Core\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
