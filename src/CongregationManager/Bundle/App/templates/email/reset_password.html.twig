<h1>{{ 'congregation_manager_app.email.reset_password.hello'|trans_app({}, localeCode) }}</h1>

<p>{{ 'congregation_manager_app.email.reset_password.intro'|trans_app({}, localeCode) }}</p>

<p>{{ 'congregation_manager_app.email.reset_password.action'|trans_app({}, localeCode) }}</p>

{% set resetUrl = url('congregation_manager_app_reset_password', {token: resetToken.token}) %}
<a href="{{ resetUrl }}">{{ resetUrl }}</a>

<p>
    {{ 'congregation_manager_app.email.reset_password.expire'|trans_app({
        '{expireIn}': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle'),
    }, localeCode) }}
</p>

<p>{{ 'congregation_manager_app.email.reset_password.greetings'|trans_app({}, localeCode) }}</p>
