<!doctype html>
<html lang="{% block language %}{{ app.request.locale|slice(0, 2) }}{% endblock %}" {% if use_dark_theme() %}data-bs-theme="dark"{% endif %}>
<head>
    <meta charset="{% block charset %}UTF-8{% endblock %}">
    <meta name="description" content="{% block meta_description %}{{ 'cm.meta.description'|trans_app }}{% endblock %}">
    <meta name="keywords" content="{% block meta_keywords %}{{ 'cm.meta.keywords'|trans_app }}{% endblock %}">
    <meta name="author" content="{% block meta_author %}{{ 'cm.meta.author'|trans_app }}{% endblock %}">
    <meta name="viewport" content="{% block meta_viewport %}width=device-width, initial-scale=1.0{% endblock %}">
    <meta name="theme-color" content="{% block meta_theme_color %}#ffffff{% endblock %}">
    <title>{% block title %}{{ 'cm.meta.title'|trans_app }}{% endblock %}</title>
    <link rel="canonical" href="{% block canonical %}{{ app.request.uri }}{% endblock %}"/>

    <meta property="og:title" content="{% block meta_og_title %}{{ block('title') }}{% endblock %}" />
    <meta property="og:description" content="{% block meta_og_description %}{{ block('meta_description') }}{% endblock %}" />
    <meta property="og:type" content="{% block meta_og_type %}website{% endblock %}" />
    <meta property="og:url" content="{% block meta_og_url %}{{ block('canonical') }}{% endblock %}" />
    <meta property="og:image" content="{% block meta_og_image %}{{ asset('app/build/images/logo.jpg', 'app') }}{% endblock %}" />

    {% block favicon %}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('app/build/favicon/apple-touch-icon.png', 'app') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('app/build/favicon/favicon-32x32.png', 'app') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('app/build/favicon/favicon-16x16.png', 'app') }}">
    <link rel="manifest" href="{{ asset('app/build/favicon/site.webmanifest', 'app') }}">
    {% endblock %}

    {% block stylesheets %}
        {{ encore_entry_link_tags('app', null, 'app') }}
    {% endblock %}
</head>
<body>
    {% block body %}
        {% block header %}
        <header>
            <nav class="navbar navbar-expand-md navbar-dark bg-dark {{ app.session.flashbag.peek('success')|length > 0 or app.session.flashbag.peek('danger')|length > 0 ? '' : 'mb-3' }}">
                <div class="container">
                    <a class="navbar-brand" href="{{ path('app_dashboard') }}">{{ 'cm.app_nav.title'|trans_app }}</a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#top-navbar" aria-controls="top-navbar" aria-expanded="false" aria-label="{{ 'cm.app_nav.toggle'|trans_app }}">
                        <span class="navbar-toggler-icon"></span>
                    </button>


                    <div class="collapse navbar-collapse" id="top-navbar">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_territory_index') }}">{{ 'cm.ui.territories'|trans_app }}</a>
                            </li>
                        </ul>

                        <div class="float-end m:w-100">
                            <div class="float-start">
                                {{ render(controller('congregation_manager_app.controller.locale::renderLoggedInAction')) }}
                            </div>
                            <div class="float-end">
                                <div class="dropdown ">
                                    <a class="d-block text-decoration-none dropdown-toggle text-white" href="#" id="dropdown-user" data-bs-toggle="dropdown" aria-expanded="false" {{ test_html_attribute('logged-in-brother-full-name', app.user.brother) }}>
                                        <img src="https://via.placeholder.com/35" alt="mdo" width="35" height="35" class="rounded-circle">
                                        {{ app.user.brother }}
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" aria-labelledby="dropdown-user">
                                        <li><a class="dropdown-item" href="{{ path('app_profile_update') }}">{{ 'cm.profile_update.title'|trans_app }}</a></li>
                                        <li><a class="dropdown-item" href="{{ path('app_change_password') }}">{{ 'cm.change_password.title'|trans_app }}</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="{{ path('congregation_manager_app_logout') }}" {{ test_html_attribute('logout-button') }}>{{ 'cm.app_nav.logout'|trans_app }}</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </nav>
        </header>
        {% endblock %}

        {% block messages %}
        <div class="container">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success" role="alert" {{ test_html_attribute('success-alert') }}>
                    {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('danger') %}
                <div class="alert alert-danger" role="alert" {{ test_html_attribute('danger-alert') }}>
                    {{ message }}
                </div>
            {% endfor %}
        </div>
        {% endblock %}

        {% block content %}{% endblock %}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app', null, 'app') }}
    {% endblock %}
</body>
</html>
