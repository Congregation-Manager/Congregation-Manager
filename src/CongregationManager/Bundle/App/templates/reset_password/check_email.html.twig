{% extends '@CongregationManagerApp/public.html.twig' %}

{% block title %}{{ 'cm.congregation_manager_app_check_email.meta_title'|trans_app }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-8 col-lg-6 m-auto text-center mt-5">

                <p>
                    {{ 'cm.congregation_manager_app_check_email.instructions'|trans_app({
                        '{expiresIn}': resetToken.expirationMessageKey|trans_app(resetToken.expirationMessageData, 'ResetPasswordBundle'),
                    })|raw }}
                </p>
                <p>
                    {{ 'cm.congregation_manager_app_check_email.try_again'|trans_app({
                        '{link}': path('congregation_manager_app_forgot_password_request'),
                    })|raw }}
                </p>

            </div>
        </div>
    </div>
{% endblock %}
