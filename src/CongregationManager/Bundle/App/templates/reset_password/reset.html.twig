{% extends '@CongregationManagerApp/public.html.twig' %}

{% block title %}{{ 'congregation_manager_app.ui.reset_password'|trans_app }}{% endblock %}

{% block meta_robots %}noindex,nofollow{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-8 col-lg-6 m-auto text-center mt-5">
                {{ block('logo') }}
                <h1 class="h3 mb-3 fw-normal">{{ 'congregation_manager_app.ui.reset_password'|trans_app }}</h1>

                {{ form_start(resetForm) }}
                {{ form_row(resetForm.plainPassword) }}
                <button class="w-100 btn btn-lg btn-primary" type="submit">
                    {{ 'congregation_manager_app.ui.save'|trans_app }}
                </button>
                {{ form_end(resetForm) }}

            </div>
        </div>
    </div>
{% endblock %}
