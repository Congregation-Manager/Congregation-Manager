{% extends '@CongregationManagerApp/base.html.twig' %}

{% block title %}{{ 'congregation_manager_app.meta_title.territory_show'|trans_app({'{number}': territory.number}) }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>{{ 'congregation_manager_app.ui.territory_with_number'|trans_app({'{number}': territory.number}) }} <span
                        class="badge badge-{% if territory.available %}success{% else %}secondary{% endif %}">
                        {% if territory.available %}{{ 'congregation_manager_app.ui.not_assigned'|trans_app }}{% else %}{{ 'congregation_manager_app.ui.assigned'|trans_app }}{% endif %}
                    </span></h1>
            </div>
        </div>
        <dl class="row mt-4">
            <dt class="col-sm-2">{{ 'congregation_manager_app.ui.area'|trans_app }}</dt>
            <dd class="col-sm-10">{{ territory.area.name }}</dd>

            <dt class="col-sm-2">{{ 'congregation_manager_app.ui.description'|trans_app }}</dt>
            <dd class="col-sm-10">{{ territory.description }}</dd>
        </dl>
        <div class="row mt-4">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th scope="col">{{ 'congregation_manager_app.ui.brother'|trans_app }}</th>
                    <th scope="col">{{ 'congregation_manager_app.ui.assignment_date'|trans_app }}</th>
                    <th scope="col">{{ 'congregation_manager_app.ui.revocation_date'|trans_app }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for territoryAssignment in territory.sortedTerritoryAssignments %}
                    <tr {{ test_html_attribute('territory-assignment', territoryAssignment.id) }}>
                        <th scope="row" {{ test_html_attribute('territory-assignment-brother', territoryAssignment.recipient) }}>{{ territoryAssignment.recipient }}</th>
                        <td {{ test_html_attribute('territory-assignment-assignment-date', territoryAssignment.assignmentDate|date()) }}>{{ territoryAssignment.assignmentDate|format_date }}</td>
                        <td>{{ territoryAssignment.revocationDate ? territoryAssignment.revocationDate|format_date : '' }}</td>
                        <td><a href="{{ path('app_territory_assignment_update', {'id': territoryAssignment.id}) }}">{{ 'congregation_manager_app.ui.edit'|trans_app }}</a> </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
