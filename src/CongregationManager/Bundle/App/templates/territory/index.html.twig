{% extends '@CongregationManagerApp/base.html.twig' %}

{% block title %}{{ 'congregation_manager_app.meta_title.territory_index'|trans_app }}{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>{{ 'congregation_manager_app.ui.territories'|trans_app }}</h1>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-12 col-lg-3">
                {{ include('@CongregationManagerApp/territory/index/_filters.html.twig') }}
                <div class="mt-5">
                    {{ render(controller('congregation_manager_app.controller.territory::s13')) }}
                </div>
            </div>
            <div class="col-12 col-lg-9">
                <div class="table-responsive-xl">
                    {{ include('@CongregationManagerApp/territory/index/_table.html.twig') }}
                </div>

                {# display navigation #}
                <div class="navigation">
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>

        </div>
    </div>
{% endblock %}
