<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="CongregationManager\Bundle\User\Model\AdminUser" table="admin_user"
            repository-class="CongregationManager\Bundle\User\Repository\AdminUserRepository">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="email" type="string" length="180" unique="true"/>

        <field name="password" type="string"/>

        <field name="roles" type="json"/>

        <field name="localeCode" column="locale_code" type="string" length="10" nullable="true" />

    </entity>

</doctrine-mapping>
