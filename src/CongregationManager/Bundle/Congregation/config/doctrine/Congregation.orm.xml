<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="CongregationManager\Component\Congregation\Domain\Congregation" table="congregation"
            repository-class="CongregationManager\Bundle\Congregation\Repository\CongregationRepository">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="name" type="string" length="255"/>

        <one-to-many field="brothers" target-entity="CongregationManager\Component\Congregation\Domain\Brother" mapped-by="congregation" />

        <one-to-many field="provinces" target-entity="CongregationManager\Component\TerritoryManager\Domain\Province" mapped-by="congregation" />

        <one-to-many field="municipalities" target-entity="CongregationManager\Component\TerritoryManager\Domain\Municipality" mapped-by="congregation" />

        <one-to-many field="areas" target-entity="CongregationManager\Component\TerritoryManager\Domain\Area" mapped-by="congregation" />

        <one-to-many field="territories" target-entity="CongregationManager\Component\TerritoryManager\Domain\Territory" mapped-by="congregation" />
    </entity>

</doctrine-mapping>
