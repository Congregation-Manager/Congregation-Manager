{
    "name": "congregation-manager/congregation-bundle",
    "type": "symfony-bundle",
    "description": "Congregation base for Symfony applications.",
    "keywords": [
        "congregation",
        "congregation-manager",
        "brother"
    ],
    "homepage": "https://github.com/congregation-manager/congregation-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "Congregation Manager",
            "homepage": "https://github.com/Congregation-Manager"
        }
    ],
    "autoload": {
        "psr-4": {
            "CongregationManager\\Bundle\\Congregation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Bundle\\Congregation\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        }
    },
    "require": {
        "php": "^8.3",
        "congregation-manager/congregation": "self.version",
        "congregation-manager/core": "self.version",
        "congregation-manager/resource-bundle": "self.version",
        "congregation-manager/resource-contract": "self.version",
        "doctrine/orm": "^2.17.1",
        "doctrine/persistence": "^3.2.0",
        "symfony/console": "^7.1.1",
        "symfony/dependency-injection": "^7.1.1",
        "symfony/form": "^7.1.1",
        "symfony/http-kernel": "^7.1.1",
        "symfony/options-resolver": "^7.1",
        "symfony/stopwatch": "^7.1.0",
        "webmozart/assert": "^1.11"
    }
}
