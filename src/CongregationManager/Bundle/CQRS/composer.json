{
    "name": "congregation-manager/CQRS-bundle",
    "type": "library",
    "description": "CQRS contract Symfony bundle.",
    "keywords": [
        "congregation-manager",
        "symfony",
        "CQRS"
    ],
    "homepage": "https://github.com/congregation-manager/congregation-manager",
    "license": "proprietary",
    "authors": [
        {
            "name": "Lorenzo Ruozzi",
            "homepage": "https://lruozzi9.github.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "CongregationManager\\Bundle\\CQRS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CongregationManager\\Bundle\\CQRS\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
