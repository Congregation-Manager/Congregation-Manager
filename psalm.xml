<?xml version="1.0"?>
<psalm
        errorLevel="1"
        findUnusedCode="false"
        findUnusedVariablesAndParams="false"
        findUnusedIssueHandlerSuppression="false"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <file name="src/CongregationManager/Bundle/Congregation/config/packages/doctrine.php"/>
            <file name="src/CongregationManager/Bundle/Resource/config/packages/doctrine.php"/>
            <file name="src/CongregationManager/Bundle/TerritoryManager/config/packages/doctrine.php"/>
            <file name="src/CongregationManager/Bundle/User/config/packages/doctrine.php"/>
            <file name="src/CongregationManager/Bundle/**/config/packages/**.php"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!-- Integration tests fetch private services by id; the plugin can only resolve them
             against the dev container, where they are not exposed. -->
        <ArgumentTypeCoercion>
            <errorLevel type="suppress">
                <directory name="src/CongregationManager/Bundle/*/tests"/>
                <directory name="src/CongregationManager/Component/*/tests"/>
            </errorLevel>
        </ArgumentTypeCoercion>
        <!-- psalm-plugin-symfony types TreeBuilder in a way that rejects scalar nodes. -->
        <InvalidTemplateParam>
            <errorLevel type="suppress">
                <file name="src/CongregationManager/Bundle/Fixtures/src/CongregationManagerFixturesBundle.php"/>
            </errorLevel>
        </InvalidTemplateParam>
        <!-- Doctrine needs to subclass the mapped models to build its proxies. -->
        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <directory name="src"/>
            </errorLevel>
        </ClassMustBeFinal>
        <InvalidArgument>
            <errorLevel type="suppress">
                <file name="src/CongregationManager/Component/User/tests/Application/CreateAdminUserTest.php"/>
            </errorLevel>
        </InvalidArgument>
        <PropertyNotSetInConstructor>
            <errorLevel type="suppress">
                <!-- Doctrine hydrates the mapped models by reflection; their state comes from the parent constructor. -->
                <directory name="src/CongregationManager/Component/Core/src/Domain"/>
                <directory name="src/CongregationManager/Bundle/Core/src/Entity"/>
                <directory name="src/CongregationManager/Bundle/*/tests"/>
                <directory name="src/CongregationManager/Component/*/tests"/>
                <directory name="src/CongregationManager/Behat/"/>
            </errorLevel>
        </PropertyNotSetInConstructor>
        <MixedMethodCall>
            <errorLevel type="suppress">
                <file name="src/CongregationManager/Bundle/Fixtures/src/CongregationManagerFixturesBundle.php"/>
            </errorLevel>
        </MixedMethodCall>
        <UndefinedMethod>
            <errorLevel type="suppress">
                <file name="src/CongregationManager/Bundle/Fixtures/src/CongregationManagerFixturesBundle.php"/>
            </errorLevel>
        </UndefinedMethod>
        <InternalMethod>
            <errorLevel type="suppress">
                <directory name="src/CongregationManager/Behat/"/>
            </errorLevel>
        </InternalMethod>
        <NonInvariantDocblockPropertyType>
            <errorLevel type="suppress">
                <directory name="src/CongregationManager/Behat/"/>
            </errorLevel>
        </NonInvariantDocblockPropertyType>
    </issueHandlers>
    <plugins>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <containerXml>var/cache/dev/KernelDevDebugContainer.xml</containerXml>
            <extraFiles>
                <directory name="var/cache/dev/Symfony/Config" /> <!-- https://github.com/psalm/psalm-plugin-symfony/issues/201 -->
            </extraFiles>
        </pluginClass>
    </plugins>
</psalm>
